+esp_err_t espframe_dpi_submit_frame(esp_lcd_panel_handle_t handle, unsigned index, const uint16_t *expected_buffer,
+                                    const uint16_t *const *sources, const size_t *lengths,
+                                    bool resisted, uint32_t elapsed_us)
+{
+    esp_lcd_dpi_panel_t *panel = __containerof(handle, esp_lcd_dpi_panel_t, base);
+    ESP_RETURN_ON_FALSE(index < panel->num_fbs && panel->fbs[index] == (const uint8_t *)expected_buffer &&
+                        index != espframe_dpi_armed_frame(handle) &&
+                        index != __atomic_load_n(&panel->cur_fb_index, __ATOMIC_ACQUIRE),
+                        ESP_ERR_INVALID_STATE, TAG, "display slot still active");
+    if (!sources) {
+        if (panel->segmented_slots[index])
+            ESP_RETURN_ON_ERROR(dpi_linked_configure_frame(panel, index, NULL, NULL), TAG, "restore display slot failed");
+        return dpi_panel_draw_bitmap(handle, 0, 0, panel->h_pixels, panel->v_pixels, expected_buffer);
+    }
+
+    ESP_RETURN_ON_FALSE(lengths, ESP_ERR_INVALID_ARG, TAG, "missing segment lengths");
+    // Restore the stock layout on a later owned submission even if a write
+    // back or descriptor setup below fails after changing this slot.
+    panel->segmented_slots[index] = true;
+    ESP_RETURN_ON_ERROR(dpi_linked_configure_frame(panel, index, sources, lengths), TAG, "configure segmented display failed");
+    const uintptr_t owned_start = (uintptr_t)expected_buffer;
+    size_t painted_bytes = 0;
+    for (unsigned i = 0; i < ESPFRAME_DPI_SEGMENTS; ++i) {
+        const uintptr_t start = (uintptr_t)sources[i];
+        if (start >= owned_start && start - owned_start < panel->fb_size) {
+            ESP_RETURN_ON_FALSE(lengths[i] <= panel->fb_size - (start - owned_start), ESP_ERR_INVALID_ARG,
+                                TAG, "painted segment exceeds output buffer");
+            ESP_RETURN_ON_ERROR(esp_cache_msync((void *)start, lengths[i], ESP_CACHE_MSYNC_FLAG_DIR_C2M |
+                                               ESP_CACHE_MSYNC_FLAG_UNALIGNED), TAG, "flush painted band failed");
+            painted_bytes += lengths[i];
+        }
+    }
+    uint32_t *submits = resisted ? &trial_edge_submits : &trial_borrowed_submits;
+    uint32_t *total = resisted ? &trial_edge_total_us : &trial_total_submit_us;
+    uint32_t *worst = resisted ? &trial_edge_worst_us : &trial_max_submit_us;
+    uint32_t *maximum_bytes = resisted ? &trial_edge_max_bytes : &trial_band_bytes;
+    __atomic_add_fetch(submits, 1, __ATOMIC_RELAXED);
+    __atomic_add_fetch(total, elapsed_us, __ATOMIC_RELAXED);
+    if (elapsed_us > __atomic_load_n(worst, __ATOMIC_RELAXED))
+        __atomic_store_n(worst, elapsed_us, __ATOMIC_RELAXED);
+    if (painted_bytes > __atomic_load_n(maximum_bytes, __ATOMIC_RELAXED))
+        __atomic_store_n(maximum_bytes, (uint32_t)painted_bytes, __ATOMIC_RELAXED);
+    __atomic_store_n(&panel->cur_fb_index, index, __ATOMIC_RELEASE);
+    return ESP_OK;
+}
