+static inline void dpi_linked_rearm_link(dw_gdma_link_list_handle_t link_list)
+{
+    for (unsigned i = 0; i < ESPFRAME_DPI_SEGMENTS; ++i) {
+        dw_gdma_block_markers_t markers = {
+            .is_valid = true,
+            .is_last = i + 1 == ESPFRAME_DPI_SEGMENTS,
+        };
+        dw_gdma_lli_set_block_markers(dw_gdma_link_list_get_item(link_list, i), markers);
+    }
+}
